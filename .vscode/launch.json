{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Attach",
            "type": "cppdbg",
            "request": "attach",
            "program": "${fileDirname}\\build\\${fileBasenameNoExtension}.exe",
            "MIMode": "gdb",
            "miDebuggerPath": "",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "gcc - Build and debug active file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": ".",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing\nskip -gfi C:/msys64/ucrt64/include/*/*/*\nskip -gfi C:/msys64/ucrt64/include/c++/*/*\nskip -gfi C:/M/B/src/mingw-w64/mingw-w64-crt/*/*/\nskip -gfi C:/M/B/src/mingw-w64/mingw-w64-crt/*\nskip -gfi /C:/msys64/ucrt64/include/c++/*",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C: gcc.exe build active file"
        },
        {
            "name": "g++ - Build and debug active file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": ".",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing\nskip -gfi C:/msys64/ucrt64/include/*/*/*\nskip -gfi C:/msys64/ucrt64/include/c++/*/*\nskip -gfi /C:/msys64/ucrt64/include/c++/*",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C++: g++.exe build active file"
        },
        {
            "name": "CMake - Build and debug active file",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${fileDirname}\\build\\Debug\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}\\build\\Debug\\",
            "environment": [],
            "externalConsole": false,
            "preLaunchTask": "CMake: build"
        }
    ]
}